// Prisma schema for Assistant.
// All models live in this one file, grouped by module with comments
// (core, tasks, meetings, team, planograms). Models are added stage by stage.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// core: users, roles, invites, notifications, settings, activity log
// ============================================================

enum Role {
  OWNER
  MANAGER
  MEMBER
  // Like a member, plus the legal check of every content post.
  LAWYER
}

model User {
  id               String    @id @default(cuid())
  telegramId       BigInt    @unique
  telegramUsername String?
  firstName        String
  lastName         String?
  photoUrl         String?
  role             Role      @default(MEMBER)
  // Set when the user pressed /start in the bot; the bot can only message such users.
  botChatId        BigInt?
  invitedById      String?
  // Employee card (stage 6).
  position         String?
  // Area of responsibility, e.g. "Ташкент, сеть Макро".
  responsibility   String?
  phone            String?
  email            String?
  startedAt        DateTime? @db.Date
  managerId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invitedBy      User?          @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers   User[]         @relation("UserInvitedBy")
  manager        User?          @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]         @relation("ManagerReports")
  notesAbout     EmployeeNote[] @relation("NoteEmployee")
  notesWritten   EmployeeNote[] @relation("NoteAuthor")
  orgNode        OrgNode?
  settings       UserSettings?
  notifications  Notification[]
  invitesCreated Invite[]       @relation("InviteCreatedBy")
  inviteUsed     Invite?        @relation("InviteUsedBy")
  activity       ActivityLog[]

  tasksCreated       Task[]                  @relation("TaskCreator")
  tasksAssigned      Task[]                  @relation("TaskAssignee")
  taskDeleteRequests Task[]                  @relation("TaskDeleteRequester")
  taskSeries         TaskSeries[]            @relation("TaskSeriesCreator")
  taskStepsOwned     TaskStep[]              @relation("TaskStepResponsible")
  taskStepsDone      TaskStep[]              @relation("TaskStepDoneBy")
  taskNotesEdited    TaskNote[]              @relation("TaskNoteEditor")
  coAssigneeAsked    TaskCoAssigneeRequest[] @relation("CoAssigneeCandidate")
  coAssigneeAsking   TaskCoAssigneeRequest[] @relation("CoAssigneeRequester")
  taskTime           TaskTimeEntry[]
  plansCreated       Plan[]
  comments           Comment[]
  attachments        TaskAttachment[]
  aiUsage            AiUsage[]
  botDrafts          BotDraft[]
  scheduledSends     ScheduledSend[]
  meetingsCreated    Meeting[]               @relation("MeetingCreator")
  meetings           MeetingParticipant[]
  meetingNotes       MeetingNotes[]
  projectsLed        Project[]               @relation("ProjectLead")
  contentAuthored    ContentPost[]           @relation("ContentAuthor")
  contentCreated     ContentPost[]           @relation("ContentCreator")
  contentComments    ContentComment[]
  projectsCreated    Project[]               @relation("ProjectCreator")
  distShipments      DistShipment[]
  distOrders         DistOrder[]
  distPurchases      DistPurchase[]          @relation("DistPurchaseCreatedBy")
  distFiles          DistCampaignFile[]
  distQuotes         DistPriceQuote[]
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  revokedAt   DateTime?
  // A place in the org chart: whoever joins with this invite takes it.
  orgNodeId   String?
  createdAt   DateTime  @default(now())

  createdBy User     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User?    @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  orgNode   OrgNode? @relation(fields: [orgNodeId], references: [id], onDelete: SetNull)
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String
  title             String
  body              String?
  // Relative app path to open, e.g. "/team".
  link              String?
  readAt            DateTime?
  sentToTelegramAt  DateTime?
  // Created during quiet hours: the scheduler sends it to Telegram when they end.
  deliverAfterQuiet Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSettings {
  userId          String   @id
  timezone        String   @default("Asia/Tashkent")
  telegramEnabled Boolean  @default(true)
  // Quiet hours in minutes from midnight (user's timezone); both null = off.
  quietHoursStart Int?
  quietHoursEnd   Int?
  // Notification types the user turned off.
  disabledTypes   String[] @default([])
  // Morning digest time in minutes from midnight (user's timezone); 510 = 08:30.
  digestTime      Int      @default(510)
  // Interface language: "ru" or "en" (site, bot and notifications).
  locale          String   @default("ru")
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// ============================================================
// tasks: tasks, dependencies, plans, comments, attachments
// ============================================================

enum TaskStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PlanLevel {
  YEAR
  MONTH
  WEEK
}

model Task {
  id                  String       @id @default(cuid())
  title               String
  description         String?
  // Personal tasks are visible only to their author and skip approval.
  isPersonal          Boolean      @default(false)
  creatorId           String
  assigneeId          String
  status              TaskStatus   @default(DRAFT)
  priority            TaskPriority @default(MEDIUM)
  project             String?
  // Calendar dates (no time of day). startDate is optional and used by the timeline.
  startDate           DateTime?    @db.Date
  dueDate             DateTime?    @db.Date
  estimateMinutes     Int?
  planId              String?
  // Set when the task came from meeting minutes.
  meetingId           String?
  // A repeating task: every copy belongs to one series (see TaskSeries).
  seriesId            String?
  // Routing (modules/tasks/routing.ts): who decides while the task waits for approval, who
  // accepts the result (null: the author, or nobody for the owner's own task), who approved it
  // (null: the route started it right away) and who accepted it.
  deciderIds          String[]
  reviewerId          String?
  approvedById        String?
  acceptedById        String?
  // The author asked for approval even where the route starts the task right away.
  needsApproval       Boolean      @default(false)
  // When the status last changed: waiting for a decision is counted from it.
  statusChangedAt     DateTime     @default(now())
  // Labels such as «отложено» from a project plan, and the people's own.
  labels              String[]
  // Co-assignees: they do what the assignee does (take it into work, tick steps, hand it in) but
  // don't accept the result. Team tasks only; see modules/tasks/co-assignees.ts.
  coAssigneeIds       String[]
  // Imported as already done (a project plan's history), accepted by nobody here.
  historical          Boolean      @default(false)
  // Project plan fields (see Project): phase, code from the plan ("T01"), who is responsible
  // per the plan (a group or role, e.g. "HO / аналитика"), milestone and risk marks.
  phaseId             String?
  code                String?
  responsible         String?
  isMilestone         Boolean      @default(false)
  atRisk              Boolean      @default(false)
  approvedAt          DateTime?
  completedAt         DateTime?
  // A deletion request (the task already had progress): waits for whoever oversees the task.
  deleteRequestedById String?
  deleteRequestedAt   DateTime?
  deleteReason        String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  creator            User                    @relation("TaskCreator", fields: [creatorId], references: [id])
  deleteRequestedBy  User?                   @relation("TaskDeleteRequester", fields: [deleteRequestedById], references: [id], onDelete: SetNull)
  assignee           User                    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  plan               Plan?                   @relation(fields: [planId], references: [id], onDelete: SetNull)
  meeting            Meeting?                @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  series             TaskSeries?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  phase              ProjectPhase?           @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  // "blockedBy": tasks that must be closed before this one can be DONE.
  blockedBy          TaskDependency[]        @relation("DependencyBlocked")
  blocks             TaskDependency[]        @relation("DependencyBlocker")
  comments           Comment[]
  attachments        TaskAttachment[]
  steps              TaskStep[]
  note               TaskNote?
  timeEntries        TaskTimeEntry[]
  coAssigneeRequests TaskCoAssigneeRequest[]

  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([dueDate])
  @@index([project])
  @@index([deleteRequestedAt])
  @@index([seriesId])
}

// A step of the work on a task («Работа»): what to do, who does it and by when, done or not.
// Steps go in `position` order; the first one not done is where the work stopped.
model TaskStep {
  id            String    @id @default(cuid())
  taskId        String
  position      Int
  title         String
  // Who does the step: the task's assignee or its author (null: whoever does the task).
  responsibleId String?
  dueDate       DateTime? @db.Date
  doneAt        DateTime?
  doneById      String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task        Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  responsible User? @relation("TaskStepResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  doneBy      User? @relation("TaskStepDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([taskId, position])
}

// The task's shared notes («Заметки»): one text per task, written by anyone who sees the task.
// Light formatting in the text itself (modules/tasks/note-format.ts). `version` grows with every
// save, so a save made over someone else's newer one is refused instead of wiping it.
// Time spent on a task (BACKLOG item 24, step 5): a timer that runs (endedAt null) or ran, or time
// added by hand. Seen in the task only for now; kept for a report later. See modules/tasks/time.ts.
model TaskTimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  startedAt DateTime
  // Null while the timer runs.
  endedAt   DateTime?
  // Set when the timer stops or the time is added by hand.
  minutes   Int       @default(0)
  manual    Boolean   @default(false)
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, endedAt])
}

model TaskNote {
  taskId           String    @id
  text             String
  version          Int       @default(1)
  updatedById      String?
  // When someone other than the task's author last changed the notes: movement for deletion.
  editedByOthersAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("TaskNoteEditor", fields: [updatedById], references: [id], onDelete: SetNull)
}

// A request to add a co-assignee who isn't in the requester's team or below (routing v2): waits
// for the person the route names (the candidate's manager, or a manager candidate themselves).
model TaskCoAssigneeRequest {
  id            String   @id @default(cuid())
  taskId        String
  userId        String
  requestedById String
  deciderIds    String[]
  createdAt     DateTime @default(now())

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User @relation("CoAssigneeCandidate", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User @relation("CoAssigneeRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// A deleted team task kept for a while (Настройки → дней хранения), so the owner can restore it:
// the task row with its comments, files, links and dependencies as they were.
model DeletedTask {
  id          String   @id
  title       String
  data        Json
  deletedById String
  reason      String?
  deletedAt   DateTime @default(now())

  @@index([deletedAt])
}

model TaskDependency {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Task @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("DependencyBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Plan {
  id          String    @id @default(cuid())
  title       String
  level       PlanLevel
  // First day of the period: Jan 1 (YEAR), 1st of month (MONTH), Monday (WEEK).
  periodStart DateTime  @db.Date
  isPersonal  Boolean   @default(false)
  createdById String
  parentId    String?
  createdAt   DateTime  @default(now())

  createdBy User   @relation(fields: [createdById], references: [id])
  parent    Plan?  @relation("PlanChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Plan[] @relation("PlanChildren")
  tasks     Task[]

  @@index([level, periodStart])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

enum AttachmentKind {
  LINK
  FILE
}

model TaskAttachment {
  id           String         @id @default(cuid())
  taskId       String
  kind         AttachmentKind
  title        String
  // LINK: the URL. FILE: null.
  url          String?
  // FILE: path relative to UPLOAD_DIR, original MIME type and size in bytes.
  filePath     String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime       @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// ============================================================
// ai: usage log for every Claude call
// ============================================================

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  // Prompt function name, e.g. "extractTasks".
  function     String
  model        String
  inputTokens  Int
  outputTokens Int
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================================
// bot: confirmation cards waiting for the user's decision
// ============================================================

model BotDraft {
  id        String   @id @default(cuid())
  userId    String
  chatId    BigInt
  // Telegram message with the card, edited in place.
  messageId Int?
  // { tasks: [...], source: "text" | "voice" }
  payload   Json
  // What the next plain text message means, e.g. { kind: "title", index: 0 }.
  awaiting  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ============================================================
// scheduler: one row per reminder/digest sent, so nothing is sent twice
// ============================================================

model ScheduledSend {
  id        String   @id @default(cuid())
  userId    String
  // "digest" | "due_reminder" | "overdue" | "weekly_summary" | "meeting_reminder"
  kind      String
  // What exactly was sent, e.g. the local date of a digest or "<taskId>:<dueDate>".
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
}

// Small key-value store for service state (e.g. the scheduler's last run, for monitoring).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// meetings: meetings, participants, minutes
// ============================================================

enum RepeatFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// A repeating task. The next copy of its latest task is made by the scheduler on the copy's
// start date (on its due date when the task has no start date); see modules/tasks/repeat.ts.
model TaskSeries {
  id        String          @id @default(cuid())
  frequency RepeatFrequency
  // Every N days / weeks / months / years.
  interval  Int             @default(1)
  // WEEKLY: 1 = Monday … 7 = Sunday (empty: the weekday of the first due date).
  weekdays  Int[]
  // MONTHLY: the day of the month (in a shorter month, its last day); null: the first due date's.
  monthDay  Int?
  // The due date of the first task: the counting starts from it.
  anchor    DateTime        @db.Date
  until     DateTime?       @db.Date
  // The due date of the next copy; null when the series has ended or was stopped.
  nextDate  DateTime?       @db.Date
  creatorId String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  creator User   @relation("TaskSeriesCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([nextDate])
}

model Meeting {
  id              String   @id @default(cuid())
  title           String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  agenda          String?
  link            String?
  createdById     String
  // Weekly meetings are stored as separate occurrences sharing one seriesId.
  seriesId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  participants MeetingParticipant[]
  notes        MeetingNotes?
  tasks        Task[]

  @@index([startsAt])
  @@index([seriesId])
}

model MeetingParticipant {
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model MeetingNotes {
  id        String   @id @default(cuid())
  meetingId String   @unique
  text      String
  authorId  String
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

// ============================================================
// team: private notes about an employee (OWNER and the direct manager only)
// ============================================================

enum EmployeeNoteKind {
  STRENGTH
  GROWTH
  ONE_ON_ONE
  GOAL
}

model EmployeeNote {
  id         String           @id @default(cuid())
  employeeId String
  authorId   String
  kind       EmployeeNoteKind
  text       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee User @relation("NoteEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author   User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([employeeId, kind])
}

// ============================================================
// planograms: equipment, SKUs, prices, POSM, planograms
// ============================================================

model Equipment {
  id        String   @id @default(cuid())
  // e.g. DISPLAY_L, MODULE_9x2, LEGO_21, POG_MINI
  code      String   @unique
  name      String
  channel   String
  // { header: null | "horizontal" | "vertical", shelves: [{ slots, offset, group }] } — see modules/planograms/geometry.ts
  geometry  Json
  // The equipment types of the equipment file (BW) this model is, e.g. ["DG_L", "MW25_L",
  // "MW24_L"] for Display L MW/DG: one shared equipment for planograms and POSM distribution.
  // A type belongs to one model at most.
  distTypes String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planograms Planogram[]
}

enum PriceLabelStyle {
  // "31 000"
  NUMBER
  // "18 ming"
  MING
}

model Sku {
  id            String          @id @default(cuid())
  code          String          @unique
  brand         String
  name          String
  format        String?
  // Path under UPLOAD_DIR of the pack picture (PNG/JPEG/WebP).
  imagePath     String?
  defaultBadges String[]        @default([])
  isNew         Boolean         @default(false)
  newSince      DateTime?       @db.Date
  isMandatory   Boolean         @default(false)
  priceStyle    PriceLabelStyle @default(NUMBER)
  // Placeholder colour when there is no picture.
  color         String          @default("#64748b")
  // Average colour of the picture's edges: the sides, top and bottom of the pack in 3D.
  sideColor     String?
  archived      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  prices SkuPrice[]
  slots  PlanogramSlot[]
}

model PriceList {
  id            String    @id @default(cuid())
  name          String
  effectiveFrom DateTime  @db.Date
  createdById   String
  // Set when the list was applied to all active planograms.
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())

  prices     SkuPrice[]
  planograms Planogram[]
}

model SkuPrice {
  priceListId String
  skuId       String
  // Price in sum.
  price       Int

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([priceListId, skuId])
}

enum PosmType {
  // Above the shelves (horizontal or vertical).
  HEADER
  // A banner taking a whole shelf or part of it.
  BANNER
  // A sticker / wobbler taking one or more slots.
  STICKER
  // A strip on a shelf's edge; the price tags stand in it (not behind a POSM over several shelves).
  SHELFTALKER
}

model Posm {
  id        String   @id @default(cuid())
  name      String
  type      PosmType
  // How many slots it covers on a shelf (ignored for HEADER).
  slotSpan  Int      @default(1)
  // How many shelves it covers downwards (a combo box over two shelves); ignored for HEADER.
  shelfSpan Int      @default(1)
  imagePath String?
  color     String   @default("#16a34a")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  slots    PlanogramSlot[]
  headerOf Planogram[]
}

enum PlanogramStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

model Planogram {
  id                String          @id @default(cuid())
  title             String
  equipmentId       String
  channel           String
  project           String?
  validFrom         DateTime?       @db.Date
  validTo           DateTime?       @db.Date
  status            PlanogramStatus @default(DRAFT)
  version           Int             @default(1)
  // All versions of one planogram share rootId (= id of version 1).
  rootId            String?
  previousVersionId String?
  priceListId       String?
  headerPosmId      String?
  // The shelftalker on each shelf that has one: { "0": posmId, "2": posmId } (shelf index).
  shelftalkers      Json            @default("{}")
  isTemplate        Boolean         @default(false)
  // Free text, e.g. lighting notes.
  notes             String?
  // Opens the approved planogram without login (for merchandisers).
  shareToken        String?         @unique
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  equipment       Equipment       @relation(fields: [equipmentId], references: [id])
  priceList       PriceList?      @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  headerPosm      Posm?           @relation(fields: [headerPosmId], references: [id], onDelete: SetNull)
  previousVersion Planogram?      @relation("PlanogramVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    Planogram[]     @relation("PlanogramVersions")
  slots           PlanogramSlot[]
  rules           PlanogramRule[]

  @@index([rootId])
  @@index([status])
}

enum SlotKind {
  SKU
  POSM
  // Deliberately left empty.
  EMPTY
}

model PlanogramSlot {
  planogramId String
  shelf       Int
  position    Int
  kind        SlotKind
  skuId       String?
  posmId      String?
  badges      String[] @default([])

  planogram Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  sku       Sku?      @relation(fields: [skuId], references: [id])
  posm      Posm?     @relation(fields: [posmId], references: [id])

  @@id([planogramId, shelf, position])
}

enum RuleKind {
  MANDATORY_SKUS
  FACINGS
  BRAND_BLOCKS
  BRAND_ORDER
  NEW_ITEMS
  ALL_SLOTS_DECIDED
}

enum RuleSeverity {
  CRITICAL
  WARNING
}

model PlanogramRule {
  id          String       @id @default(cuid())
  planogramId String
  kind        RuleKind
  severity    RuleSeverity
  enabled     Boolean      @default(true)
  // Rule settings, e.g. { "shelves": [0] } or { "order": ["ESSE", "BOHEM", "PINE"] }.
  params      Json         @default("{}")

  planogram Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)

  @@unique([planogramId, kind])
}

// ============================================================
// Org structure (drawn by the owner): units and positions in one tree.
// ============================================================

enum OrgNodeKind {
  // A department / team / project team (bold name, type below).
  UNIT
  // A position: a person in the app, a person not in the app, or a vacancy.
  POSITION
}

model OrgNode {
  id         String      @id @default(cuid())
  kind       OrgNodeKind
  // UNIT: the unit's name.
  name       String?
  // UNIT: its type ("Project Team"); POSITION: the job title.
  title      String?
  // Small caption above a position, e.g. the team it leads ("Marketing Team").
  label      String?
  // POSITION: a user of the app...
  userId     String?     @unique
  // ...or the name of someone who doesn't use it. Both empty = vacancy.
  personName String?
  parentId   String?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")
  invites  Invite[]

  @@index([parentId])
}

// ============================================================
// Projects: a named project with a lead, phases and its tasks.
// Tasks belong to a project by name (Task.project), so tasks created with that project name
// in the usual form join it, and reports keep grouping by the same field.
// ============================================================

model Project {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  // The team running it, e.g. "Marketing Execution".
  team         String?
  leadId       String?
  createdById  String
  // Its colour on dashboards: 0..7, a slot of the --series-N palette, kept for good.
  color        Int       @default(0)
  // The template it was created from (modules/projects/templates.ts), e.g. "launch".
  template     String?
  // The day the plan is counted from, e.g. the start of sales ("T") for a launch.
  anchorDate   DateTime? @db.Date
  // The written plan (e.g. the Launching Plan): { sectionKey: text }.
  planSections Json?
  archived     Boolean   @default(false)
  // «Завершить проект»: off the home screen and the portfolio, under «Завершённые».
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead       User?          @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy  User           @relation("ProjectCreator", fields: [createdById], references: [id])
  phases     ProjectPhase[]
  distOrders DistOrder[]
}

model ProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  title     String
  sortOrder Int       @default(0)
  // The deadline set for the phase (its tasks may have their own dates).
  dueDate   DateTime? @db.Date

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

// ============================================================
// Content plan: posts for the company's Telegram bots, by date. An author uploads the visual and
// texts (RU + UZ), a reviewer gives feedback or approves, then someone sends it to each bot and
// marks it sent.
// ============================================================

enum ContentChannel {
  PARTNER
  CONNECT
  RESEARCH
}

enum ContentStatus {
  // Planned: a topic and a date, nothing uploaded yet.
  PLANNED
  // The author is working on it (something uploaded).
  DRAFT
  // Sent for review.
  REVIEW
  // Approved by a planner, checked by the lawyer.
  LEGAL_REVIEW
  // Returned with feedback.
  CHANGES
  APPROVED
  // Sent to every bot it is planned for.
  SENT
  CANCELLED
}

// Sections (topics) of the content plan, for the analytics. The owner and managers add,
// rename, order and hide them; AI puts every post into one of the active sections.
// The first eight keep their old codes as ids (PRICES, NEW_PRODUCTS, ...).
model ContentSection {
  id          String   @id @default(cuid())
  name        String
  // The name in English (for people who use the app in English); empty = the Russian name.
  nameEn      String?
  // What belongs here: shown to the AI that sorts posts.
  description String?
  sortOrder   Int      @default(0)
  // Hidden: no new posts go here; old ones keep it.
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  posts ContentPost[]
}

enum ContentLang {
  RU
  UZ
}

enum ContentFileKind {
  PHOTO
  VIDEO
  FILE
}

// Visuals and files of a post, separately for each language (up to 10 each).
// Stored under UPLOAD_DIR/content/<postId>/.
model ContentFile {
  id        String          @id @default(cuid())
  postId    String
  lang      ContentLang
  kind      ContentFileKind
  path      String
  name      String
  mime      String
  size      Int
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, lang, sortOrder])
}

enum ContentBrand {
  ESSE
  BOHEM
  PINE
  BLOOMING
  SIMPLE
  GENERAL
}

model ContentPost {
  id           String           @id @default(cuid())
  // Topic, e.g. "Новые цены ESSE Super Slim".
  title        String
  // What is needed: the brief for the author.
  brief        String?
  channels     ContentChannel[]
  publishDate  DateTime         @db.Date
  // "HH:MM", optional.
  publishTime  String?
  status       ContentStatus    @default(PLANNED)
  authorId     String?
  createdById  String
  textRu       String?
  textUz       String?
  sentChannels ContentChannel[]
  // The section (ContentSection.id).
  topic        String?
  brand        ContentBrand?
  // "ai", "keywords" or "manual" (set by hand: never changed automatically).
  tagSource    String?
  // Waiting for (re)tagging by the background worker.
  tagPending   Boolean          @default(true)
  approvedAt   DateTime?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  author    User?            @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  section   ContentSection?  @relation(fields: [topic], references: [id], onDelete: SetNull)
  createdBy User             @relation("ContentCreator", fields: [createdById], references: [id])
  comments  ContentComment[]
  files     ContentFile[]

  @@index([publishDate])
  @@index([authorId, status])
  @@index([tagPending])
}

model ContentComment {
  id         String   @id @default(cuid())
  postId     String
  authorId   String
  body       String
  // true = feedback that returned the post for changes.
  isFeedback Boolean  @default(false)
  createdAt  DateTime @default(now())

  post   ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id])

  @@index([postId])
}

// ============================================================
// Connect analytics: exports of the Connect bot (stock checks, express orders,
// ISM payment requests, market visits), uploaded as Excel and analysed on three levels.
// ============================================================

enum ConnectKind {
  OOS
  ORDER
  PAYMENT
  VISIT
}

// One row of an export. Uploading a newer export updates the rows with the same ID.
model ConnectRecord {
  id         String      @id @default(cuid())
  kind       ConnectKind
  // The bot's own ID: check ID, order number, request ID.
  externalId String
  storeCode  String
  storeName  String
  city       String?
  channel    String?
  // The day of the check / order / request in Tashkent (YYYY-MM-DD) and its month (YYYY-MM).
  day        String
  month      String
  // Who did it: the checker, the order's creator, the request's TSM, the visit's executor.
  person     String?
  // The parsed row (typed per kind, see modules/connect/parse.ts).
  data       Json
  importId   String
  // How fresh the file that last wrote the row was: its latest record time (YYYY-MM-DDTHH:mm).
  // A file older than that doesn't overwrite the row (a later export has the newer statuses).
  asOf       String?
  updatedAt  DateTime    @updatedAt

  @@unique([kind, externalId])
  @@index([kind, month])
}

model ConnectImport {
  id        String   @id @default(cuid())
  userId    String?
  fileName  String
  kinds     String
  created   Int
  updated   Int
  skipped   Int
  // Rows left as they were because the file is older than what was loaded.
  kept      Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================================
// POSM distribution by region and TSM (separate from the planogram POSM library)
// ============================================================

enum DistCountKind {
  // Installed in the shops
  INSTALLED
  // In the regional warehouses, not installed yet
  STOCK
}

// How many units of one equipment type a region has in its warehouse (STOCK). Installed
// equipment comes unit by unit (DistUnit); INSTALLED rows are left from the first file format.
model DistEquipmentCount {
  id     String        @id @default(cuid())
  kind   DistCountKind
  region String
  // "" = the whole region; otherwise the TSM (old file format).
  tsm    String        @default("")
  // An equipment type code from modules/distribution/types.ts, e.g. "POSI_XL".
  type   String
  // Display MOD is counted in 18-slot units, so it can be fractional.
  count  Float

  @@unique([kind, region, tsm, type])
}

// One installed piece of equipment from the «BW management» list of the equipment file.
model DistUnit {
  id        String @id @default(cuid())
  // The outlet's Smartup ID ("" when the row has none): links it to the outlet base (DistOutlet)
  // for the responsible TSM. The TSM is never stored here: it is looked up at calculation time.
  outletId  String @default("")
  // Who the outlet is: its Smartup ID, else "region|tin:…" or "region|name:…" (rows without an
  // ID are replaced on every upload, never matched by hand).
  outletKey String @default("")
  region    String
  type      String
  // 1 for a display; Display MOD: its slots / 18 (the file's own unit, as in its totals).
  units     Float
  posName   String @default("")
  tin       String @default("")

  @@index([outletId])
}

// When each Smartup ID first appeared in an equipment file: for the «new outlets» list.
model DistSeenOutlet {
  outletId  String   @id
  firstSeen DateTime @default(now())
  posName   String   @default("")
  tin       String   @default("")
}

// A row of «BW management» that could not be counted (no ID, no TIN, no name; or an unknown
// type): replaced on every upload.
model DistSkippedRow {
  id          String @id @default(cuid())
  row         Int
  reason      String
  region      String @default("")
  description String @default("")
}

// The purchase journal: how much of each equipment type was bought. Its sum is the ceiling of
// the control equation (bought = installed + in stock + unaccounted). Entered by hand only.
model DistPurchase {
  id          String   @id @default(cuid())
  // One type, or a group bought as one (e.g. Display L = DG L + Metawerk L): the control
  // equation then checks the group as a whole.
  types       String[]
  // Display MOD in 18-slot units, like everywhere else.
  quantity    Float
  date        DateTime @db.Date
  document    String
  note        String?
  createdById String
  createdBy   User     @relation("DistPurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// An equipment file waiting for confirmation: its control equation has a minus.
model DistPendingImport {
  id          String   @id @default(cuid())
  payload     Json
  createdById String
  createdAt   DateTime @default(now())
}

// The outlet base: who is the responsible TSM of each outlet (only what the split needs). Its
// region is never used in the counts, only to list outlets whose region differs from the file.
model DistOutlet {
  outletId String  @id
  region   String?
  tsm      String?
}

// A POSM campaign (e.g. "Pine Purple 4 SKU"): concept → key visual → what to order on which
// equipment → prices → order → split by region and TSM → replacement in the shops. Its POSM
// list is a version of its own: old campaigns keep their plan and shipments.
model DistOrder {
  id                String    @id @default(cuid())
  name              String
  description       String?
  // The project the concept is worked on in (tasks, phases), if any.
  projectId         String?
  conceptApprovedAt DateTime?
  kvFinalAt         DateTime?
  // The reserve added on top of the need when the list is made (0.1 = +10%).
  reservePct        Float     @default(0.1)
  // Reserve by equipment type ({ "POSI_L": 0.2 }); a type not in it takes reservePct.
  reserveByType     Json?
  // Count equipment in warehouses too (the order is for all equipment, wherever it is).
  withStock         Boolean   @default(true)
  // The EAS approval document's fields (budget, texts, the printers compared): see eas.ts.
  eas               Json?
  // When the POSM was ordered from the printer; the list doesn't change after.
  orderedOn         DateTime? @db.Date
  note              String?
  // A closed campaign is kept for history; new shipments go to open ones.
  closed            Boolean   @default(false)
  createdById       String
  createdAt         DateTime  @default(now())

  posm         DistPosm[]
  createdBy    User                  @relation(fields: [createdById], references: [id])
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  files        DistCampaignFile[]
  elements     DistCampaignElement[]
  replacements DistReplacement[]
}

enum DistFileKind {
  CONCEPT
  KEY_VISUAL
  // The printer's quote (КП).
  QUOTE
  EAS
  OTHER
}

model DistCampaignFile {
  id          String       @id @default(cuid())
  orderId     String
  kind        DistFileKind
  name        String
  // Relative to UPLOAD_DIR.
  path        String
  mime        String
  size        Int
  // The final key visual.
  final       Boolean      @default(false)
  createdById String
  createdAt   DateTime     @default(now())

  order     DistOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([orderId])
}

// What a campaign orders: an element of the catalog on its own set of equipment types.
model DistCampaignElement {
  id        String   @id @default(cuid())
  orderId   String
  elementId String
  types     String[] @default([])
  // Pieces per unit for this campaign, by type: { "POSI_L": 2 } (else the catalog's).
  perUnit   Json?

  order   DistOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  element DistElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([orderId, elementId])
}

// The printer's prices: every confirmed or new price is kept with who gave it.
model DistPriceQuote {
  id          String   @id @default(cuid())
  elementId   String
  type        String
  price       Float
  supplier    String?
  quoteNo     String?
  quotedOn    DateTime @db.Date
  orderId     String?
  createdById String
  createdAt   DateTime @default(now())

  element   DistElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  createdBy User        @relation(fields: [createdById], references: [id])

  @@index([elementId, type])
}

// Replacement in the shops: has the outlet got the campaign's POSM.
model DistReplacement {
  orderId   String
  outletId  String
  replaced  Boolean
  updatedAt DateTime @updatedAt

  order DistOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, outletId])
}

// The order builder's catalog. Equipment dimensions by type (from the KT&G sizes sheet).
model DistTypeSize {
  // An equipment type code from modules/distribution/types.ts.
  type     String  @id
  heightMm Float?
  widthMm  Float?
  depthMm  Float?
  note     String?
}

// A kind of POSM the builder orders: Header, Shelftalker, Divider, price tag…
model DistElement {
  id       String  @id @default(cuid())
  name     String  @unique
  position Int     @default(0)
  material String?

  sizes     DistElementSize[]
  campaigns DistCampaignElement[]
  quotes    DistPriceQuote[]
}

// The print size of an element on one equipment type: it differs by equipment, so each pair is
// its own row. Empty sizes or price = still to fill in.
model DistElementSize {
  id        String  @id @default(cuid())
  elementId String
  type      String
  heightMm  Float?
  widthMm   Float?
  // Pieces on one unit of the equipment.
  perUnit   Float?
  // Price of one piece.
  price     Float?
  material  String?
  note      String?
  // Taken from an old POSM list, not confirmed for this equipment yet.
  verified  Boolean @default(false)

  element DistElement @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([elementId, type])
}

enum DistBase {
  // By the number of equipment units
  UNITS
  // By the number of slots (shelf places) on the equipment
  SLOTS
  // Price tags: by the facings with this price on the equipment's planogram
  PLANOGRAM
}

// A POSM item to distribute: stock, order, reserve, and the equipment types it goes to.
model DistPosm {
  id               String    @id @default(cuid())
  orderId          String
  position         Int
  name             String
  category         String
  equipmentLabel   String?
  size             String?
  material         String?
  // Equipment count the order was made for
  orderedFor       Int       @default(0)
  inStock          Int       @default(0)
  ordered          Int       @default(0)
  // Share kept at the central warehouse, 0..1
  reservePct       Float     @default(0)
  base             DistBase  @default(UNITS)
  // Pieces per equipment unit and the reserve on top of it (0.1 = +10%); null = no norm.
  norm             Float?
  normReserve      Float     @default(0)
  // Equipment type codes this POSM goes to.
  types            String[]  @default([])
  // Made by a campaign from this catalog element; its price per piece (UZS incl. VAT).
  elementId        String?
  price            Float?
  priceConfirmedAt DateTime?
  supplier         String?
  quoteNo          String?
  updatedAt        DateTime  @updatedAt

  order     DistOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipments DistShipment[]

  @@unique([orderId, name])
}

// POSM that left the central warehouse: where to, how many, when.
model DistShipment {
  id          String   @id @default(cuid())
  posmId      String
  // A region, or "<region> · <TSM>".
  destination String
  quantity    Int
  shippedOn   DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  posm      DistPosm @relation(fields: [posmId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([posmId])
  @@index([destination])
}
