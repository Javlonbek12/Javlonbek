// Prisma schema for Assistant.
// All models live in this one file, grouped by module with comments
// (core, tasks, meetings, team, planograms). Models are added stage by stage.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// core: users, roles, invites, notifications, settings, activity log
// ============================================================

enum Role {
  OWNER
  MANAGER
  MEMBER
}

model User {
  id               String    @id @default(cuid())
  telegramId       BigInt    @unique
  telegramUsername String?
  firstName        String
  lastName         String?
  photoUrl         String?
  role             Role      @default(MEMBER)
  // Set when the user pressed /start in the bot; the bot can only message such users.
  botChatId        BigInt?
  invitedById      String?
  // Employee card (stage 6).
  position         String?
  // Area of responsibility, e.g. "Ташкент, сеть Макро".
  responsibility   String?
  phone            String?
  email            String?
  startedAt        DateTime? @db.Date
  managerId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  invitedBy      User?          @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers   User[]         @relation("UserInvitedBy")
  manager        User?          @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]         @relation("ManagerReports")
  notesAbout     EmployeeNote[] @relation("NoteEmployee")
  notesWritten   EmployeeNote[] @relation("NoteAuthor")
  orgNode        OrgNode?
  settings       UserSettings?
  notifications  Notification[]
  invitesCreated Invite[]       @relation("InviteCreatedBy")
  inviteUsed     Invite?        @relation("InviteUsedBy")
  activity       ActivityLog[]

  tasksCreated    Task[]               @relation("TaskCreator")
  tasksAssigned   Task[]               @relation("TaskAssignee")
  plansCreated    Plan[]
  comments        Comment[]
  attachments     TaskAttachment[]
  aiUsage         AiUsage[]
  botDrafts       BotDraft[]
  scheduledSends  ScheduledSend[]
  meetingsCreated Meeting[]            @relation("MeetingCreator")
  meetings        MeetingParticipant[]
  meetingNotes    MeetingNotes[]
  projectsLed     Project[]            @relation("ProjectLead")
  projectsCreated Project[]            @relation("ProjectCreator")
}

model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  role        Role
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique
  revokedAt   DateTime?
  // A place in the org chart: whoever joins with this invite takes it.
  orgNodeId   String?
  createdAt   DateTime  @default(now())

  createdBy User     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User?    @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  orgNode   OrgNode? @relation(fields: [orgNodeId], references: [id], onDelete: SetNull)
}

model Notification {
  id                String    @id @default(cuid())
  userId            String
  type              String
  title             String
  body              String?
  // Relative app path to open, e.g. "/team".
  link              String?
  readAt            DateTime?
  sentToTelegramAt  DateTime?
  // Created during quiet hours: the scheduler sends it to Telegram when they end.
  deliverAfterQuiet Boolean   @default(false)
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSettings {
  userId          String   @id
  timezone        String   @default("Asia/Tashkent")
  telegramEnabled Boolean  @default(true)
  // Quiet hours in minutes from midnight (user's timezone); both null = off.
  quietHoursStart Int?
  quietHoursEnd   Int?
  // Notification types the user turned off.
  disabledTypes   String[] @default([])
  // Morning digest time in minutes from midnight (user's timezone); 510 = 08:30.
  digestTime      Int      @default(510)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// ============================================================
// tasks: tasks, dependencies, plans, comments, attachments
// ============================================================

enum TaskStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PlanLevel {
  YEAR
  MONTH
  WEEK
}

model Task {
  id              String       @id @default(cuid())
  title           String
  description     String?
  // Personal tasks are visible only to their author and skip approval.
  isPersonal      Boolean      @default(false)
  creatorId       String
  assigneeId      String
  status          TaskStatus   @default(DRAFT)
  priority        TaskPriority @default(MEDIUM)
  project         String?
  // Calendar dates (no time of day). startDate is optional and used by the timeline.
  startDate       DateTime?    @db.Date
  dueDate         DateTime?    @db.Date
  estimateMinutes Int?
  planId          String?
  // Set when the task came from meeting minutes.
  meetingId       String?
  // Project plan fields (see Project): phase, code from the plan ("T01"), who is responsible
  // per the plan (a group or role, e.g. "HO / аналитика"), milestone and risk marks.
  phaseId         String?
  code            String?
  responsible     String?
  isMilestone     Boolean      @default(false)
  atRisk          Boolean      @default(false)
  approvedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  plan        Plan?            @relation(fields: [planId], references: [id], onDelete: SetNull)
  meeting     Meeting?         @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  phase       ProjectPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  // "blockedBy": tasks that must be closed before this one can be DONE.
  blockedBy   TaskDependency[] @relation("DependencyBlocked")
  blocks      TaskDependency[] @relation("DependencyBlocker")
  comments    Comment[]
  attachments TaskAttachment[]

  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([dueDate])
  @@index([project])
}

model TaskDependency {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker Task @relation("DependencyBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked Task @relation("DependencyBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model Plan {
  id          String    @id @default(cuid())
  title       String
  level       PlanLevel
  // First day of the period: Jan 1 (YEAR), 1st of month (MONTH), Monday (WEEK).
  periodStart DateTime  @db.Date
  isPersonal  Boolean   @default(false)
  createdById String
  parentId    String?
  createdAt   DateTime  @default(now())

  createdBy User   @relation(fields: [createdById], references: [id])
  parent    Plan?  @relation("PlanChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Plan[] @relation("PlanChildren")
  tasks     Task[]

  @@index([level, periodStart])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

enum AttachmentKind {
  LINK
  FILE
}

model TaskAttachment {
  id           String         @id @default(cuid())
  taskId       String
  kind         AttachmentKind
  title        String
  // LINK: the URL. FILE: null.
  url          String?
  // FILE: path relative to UPLOAD_DIR, original MIME type and size in bytes.
  filePath     String?
  mimeType     String?
  sizeBytes    Int?
  uploadedById String
  createdAt    DateTime       @default(now())

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])
}

// ============================================================
// ai: usage log for every Claude call
// ============================================================

model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  // Prompt function name, e.g. "extractTasks".
  function     String
  model        String
  inputTokens  Int
  outputTokens Int
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============================================================
// bot: confirmation cards waiting for the user's decision
// ============================================================

model BotDraft {
  id        String   @id @default(cuid())
  userId    String
  chatId    BigInt
  // Telegram message with the card, edited in place.
  messageId Int?
  // { tasks: [...], source: "text" | "voice" }
  payload   Json
  // What the next plain text message means, e.g. { kind: "title", index: 0 }.
  awaiting  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

// ============================================================
// scheduler: one row per reminder/digest sent, so nothing is sent twice
// ============================================================

model ScheduledSend {
  id        String   @id @default(cuid())
  userId    String
  // "digest" | "due_reminder" | "overdue" | "weekly_summary" | "meeting_reminder"
  kind      String
  // What exactly was sent, e.g. the local date of a digest or "<taskId>:<dueDate>".
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
}

// Small key-value store for service state (e.g. the scheduler's last run, for monitoring).
model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// meetings: meetings, participants, minutes
// ============================================================

model Meeting {
  id              String   @id @default(cuid())
  title           String
  startsAt        DateTime
  durationMinutes Int      @default(60)
  agenda          String?
  link            String?
  createdById     String
  // Weekly meetings are stored as separate occurrences sharing one seriesId.
  seriesId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy    User                 @relation("MeetingCreator", fields: [createdById], references: [id])
  participants MeetingParticipant[]
  notes        MeetingNotes?
  tasks        Task[]

  @@index([startsAt])
  @@index([seriesId])
}

model MeetingParticipant {
  meetingId String
  userId    String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([meetingId, userId])
}

model MeetingNotes {
  id        String   @id @default(cuid())
  meetingId String   @unique
  text      String
  authorId  String
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

// ============================================================
// team: private notes about an employee (OWNER and the direct manager only)
// ============================================================

enum EmployeeNoteKind {
  STRENGTH
  GROWTH
  ONE_ON_ONE
  GOAL
}

model EmployeeNote {
  id         String           @id @default(cuid())
  employeeId String
  authorId   String
  kind       EmployeeNoteKind
  text       String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee User @relation("NoteEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  author   User @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([employeeId, kind])
}

// ============================================================
// planograms: equipment, SKUs, prices, POSM, planograms
// ============================================================

model Equipment {
  id        String   @id @default(cuid())
  // e.g. DISPLAY_L, MODULE_9x2, LEGO_21, POG_MINI
  code      String   @unique
  name      String
  channel   String
  // { header: null | "horizontal" | "vertical", shelves: [{ slots, offset, group }] } — see modules/planograms/geometry.ts
  geometry  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planograms Planogram[]
}

enum PriceLabelStyle {
  // "31 000"
  NUMBER
  // "18 ming"
  MING
}

model Sku {
  id            String          @id @default(cuid())
  code          String          @unique
  brand         String
  name          String
  format        String?
  // Path under UPLOAD_DIR of the pack picture (PNG/JPEG/WebP).
  imagePath     String?
  defaultBadges String[]        @default([])
  isNew         Boolean         @default(false)
  newSince      DateTime?       @db.Date
  isMandatory   Boolean         @default(false)
  priceStyle    PriceLabelStyle @default(NUMBER)
  // Placeholder colour when there is no picture.
  color         String          @default("#64748b")
  archived      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  prices SkuPrice[]
  slots  PlanogramSlot[]
}

model PriceList {
  id            String    @id @default(cuid())
  name          String
  effectiveFrom DateTime  @db.Date
  createdById   String
  // Set when the list was applied to all active planograms.
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())

  prices     SkuPrice[]
  planograms Planogram[]
}

model SkuPrice {
  priceListId String
  skuId       String
  // Price in sum.
  price       Int

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@id([priceListId, skuId])
}

enum PosmType {
  // Above the shelves (horizontal or vertical).
  HEADER
  // A banner taking a whole shelf or part of it.
  BANNER
  // A sticker / wobbler taking one or more slots.
  STICKER
}

model Posm {
  id        String   @id @default(cuid())
  name      String
  type      PosmType
  // How many slots it covers on a shelf (ignored for HEADER).
  slotSpan  Int      @default(1)
  imagePath String?
  color     String   @default("#16a34a")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  slots    PlanogramSlot[]
  headerOf Planogram[]
}

enum PlanogramStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ARCHIVED
}

model Planogram {
  id                String          @id @default(cuid())
  title             String
  equipmentId       String
  channel           String
  project           String?
  validFrom         DateTime?       @db.Date
  validTo           DateTime?       @db.Date
  status            PlanogramStatus @default(DRAFT)
  version           Int             @default(1)
  // All versions of one planogram share rootId (= id of version 1).
  rootId            String?
  previousVersionId String?
  priceListId       String?
  headerPosmId      String?
  isTemplate        Boolean         @default(false)
  // Free text, e.g. lighting notes.
  notes             String?
  // Opens the approved planogram without login (for merchandisers).
  shareToken        String?         @unique
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  equipment       Equipment       @relation(fields: [equipmentId], references: [id])
  priceList       PriceList?      @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  headerPosm      Posm?           @relation(fields: [headerPosmId], references: [id], onDelete: SetNull)
  previousVersion Planogram?      @relation("PlanogramVersions", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    Planogram[]     @relation("PlanogramVersions")
  slots           PlanogramSlot[]
  rules           PlanogramRule[]

  @@index([rootId])
  @@index([status])
}

enum SlotKind {
  SKU
  POSM
  // Deliberately left empty.
  EMPTY
}

model PlanogramSlot {
  planogramId String
  shelf       Int
  position    Int
  kind        SlotKind
  skuId       String?
  posmId      String?
  badges      String[] @default([])

  planogram Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)
  sku       Sku?      @relation(fields: [skuId], references: [id])
  posm      Posm?     @relation(fields: [posmId], references: [id])

  @@id([planogramId, shelf, position])
}

enum RuleKind {
  MANDATORY_SKUS
  FACINGS
  BRAND_BLOCKS
  BRAND_ORDER
  NEW_ITEMS
  ALL_SLOTS_DECIDED
}

enum RuleSeverity {
  CRITICAL
  WARNING
}

model PlanogramRule {
  id          String       @id @default(cuid())
  planogramId String
  kind        RuleKind
  severity    RuleSeverity
  enabled     Boolean      @default(true)
  // Rule settings, e.g. { "shelves": [0] } or { "order": ["ESSE", "BOHEM", "PINE"] }.
  params      Json         @default("{}")

  planogram Planogram @relation(fields: [planogramId], references: [id], onDelete: Cascade)

  @@unique([planogramId, kind])
}

// ============================================================
// Org structure (drawn by the owner): units and positions in one tree.
// ============================================================

enum OrgNodeKind {
  // A department / team / project team (bold name, type below).
  UNIT
  // A position: a person in the app, a person not in the app, or a vacancy.
  POSITION
}

model OrgNode {
  id         String      @id @default(cuid())
  kind       OrgNodeKind
  // UNIT: the unit's name.
  name       String?
  // UNIT: its type ("Project Team"); POSITION: the job title.
  title      String?
  // Small caption above a position, e.g. the team it leads ("Marketing Team").
  label      String?
  // POSITION: a user of the app...
  userId     String?     @unique
  // ...or the name of someone who doesn't use it. Both empty = vacancy.
  personName String?
  parentId   String?
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  parent   OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children OrgNode[] @relation("OrgTree")
  invites  Invite[]

  @@index([parentId])
}

// ============================================================
// Projects: a named project with a lead, phases and its tasks.
// Tasks belong to a project by name (Task.project), so tasks created with that project name
// in the usual form join it, and reports keep grouping by the same field.
// ============================================================

model Project {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  // The team running it, e.g. "Marketing Execution".
  team         String?
  leadId       String?
  createdById  String
  // Its colour on dashboards: 0..7, a slot of the --series-N palette, kept for good.
  color        Int       @default(0)
  // The template it was created from (modules/projects/templates.ts), e.g. "launch".
  template     String?
  // The day the plan is counted from, e.g. the start of sales ("T") for a launch.
  anchorDate   DateTime? @db.Date
  // The written plan (e.g. the Launching Plan): { sectionKey: text }.
  planSections Json?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead      User?          @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy User           @relation("ProjectCreator", fields: [createdById], references: [id])
  phases    ProjectPhase[]
}

model ProjectPhase {
  id        String    @id @default(cuid())
  projectId String
  title     String
  sortOrder Int       @default(0)
  // The deadline set for the phase (its tasks may have their own dates).
  dueDate   DateTime? @db.Date

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}
