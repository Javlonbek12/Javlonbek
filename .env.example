# Скопируйте этот файл в .env и заполните значения.
# Файл .env хранит секреты — никогда не добавляйте его в git.

# --- Используется уже сейчас (этап 0) ---

# Адрес базы данных PostgreSQL. Значение ниже подходит для локальной базы из docker-compose.yml.
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant

# Адрес, по которому открывается приложение (в проде — ваш домен с https://).
APP_URL=http://localhost:3000

# Таймзона по умолчанию. Время в базе хранится в UTC, показывается в этой таймзоне.
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Понадобится на следующих этапах (пока можно оставить пустым) ---

# Секрет для подписи сессий (длинная случайная строка). Этап 1.
SESSION_SECRET=

# Telegram-бот: токен от @BotFather, имя бота без @ и секрет для webhook. Этап 1.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Ключ Anthropic API и модель Claude. Этап 3.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Сколько обращений к ИИ в день разрешено одному пользователю.
AI_DAILY_LIMIT=200

# Распознавание речи: whisper (свой сервер) | openai (внешний сервис) | mock (заглушка для разработки). Этап 3.
STT_PROVIDER=mock
WHISPER_URL=
STT_API_URL=
STT_API_KEY=

# Папка для загруженных файлов (картинки пачек, вложения).
UPLOAD_DIR=./uploads
