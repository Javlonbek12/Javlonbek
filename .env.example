# Скопируйте этот файл в .env и заполните значения.
# Файл .env хранит секреты — никогда не добавляйте его в git.

# --- База данных ---

# Адрес базы данных PostgreSQL. Значение ниже подходит для локальной базы из docker-compose.yml.
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant

# Отдельная база для автотестов (тесты её очищают!). Имя обязательно должно заканчиваться на _test.
TEST_DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant_test

# --- Приложение ---

# Адрес, по которому открывается приложение (в проде — ваш домен с https://).
APP_URL=http://localhost:3000

# Секрет для подписи входа (сессий): любая случайная строка длиной 32+ символа.
# Сгенерировать: openssl rand -hex 32   (или любой генератор паролей)
# Если поменять — всем придётся войти заново.
SESSION_SECRET=

# Вход для разработки (без Telegram): true — показать на странице входа форму «войти как тестовый пользователь».
# Работает только на вашем компьютере; на боевом сервере всегда выключен, даже если здесь true.
ALLOW_DEV_LOGIN=true

# Таймзона по умолчанию. Время в базе хранится в UTC, показывается в таймзоне пользователя.
DEFAULT_TIMEZONE=Asia/Tashkent

# --- Telegram-бот ---
# Создайте бота у @BotFather в Telegram (команда /newbot) и вставьте сюда токен и имя бота (без @).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет для webhook (нужен только на сервере): любая случайная строка из латинских букв и цифр.
TELEGRAM_WEBHOOK_SECRET=

# --- ИИ (Claude) ---
# Ключ Anthropic API: https://console.anthropic.com → API Keys. Без ключа бот сохраняет сообщение как одну задачу.
ANTHROPIC_API_KEY=
# Модель Claude (по умолчанию быстрая и недорогая Haiku 4.5).
CLAUDE_MODEL=claude-haiku-4-5
# Сколько обращений к ИИ в день разрешено одному пользователю.
AI_DAILY_LIMIT=200

# --- Распознавание голоса ---
# whisper — свой сервер faster-whisper (бесплатно, нужен сервер);
# openai — внешний сервис с OpenAI-совместимым API (платно);
# mock — заглушка для разработки: всегда «распознаёт» текст из STT_MOCK_TEXT.
STT_PROVIDER=mock
# Для whisper: адрес сервера без пути, например http://whisper:8000
WHISPER_URL=
# Для openai: адрес API с /v1, например https://api.openai.com/v1, и ключ.
STT_API_URL=
STT_API_KEY=
# Необязательно: название модели распознавания (по умолчанию Systran/faster-whisper-small или whisper-1).
STT_MODEL=
# Для mock: какой текст «распознаётся» из любого голосового.
STT_MOCK_TEXT=

# --- Файлы ---
# Папка для загруженных файлов (картинки пачек, вложения).
UPLOAD_DIR=./uploads
